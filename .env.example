# LLM Configuration（OpenAI 兼容，优先级: kimi > qwen > deepseek > ollama）
KIMI_API_KEY=your-kimi-platform-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model Routing（模型名含 kimi/moonshot/qwen/deepseek/ollama 自动路由到对应 provider）
DEFAULT_MODEL=qwen-plus
FALLBACK_MODEL=qwen-turbo
SIMPLE_TASK_MODEL=qwen-turbo
COMPLEX_TASK_MODEL=qwen-plus

# Ollama 本地/离线 LLM（内网生产部署，见 deployment/ollama-setup.md）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OFFLINE_ENABLED=true
OFFLINE_LLM_MODEL=qwen2.5:14b

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# Elasticsearch
ES_HOST=http://localhost:9200
ES_USER=
ES_PASSWORD=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=manufacturing
POSTGRES_PASSWORD=manufacturing
POSTGRES_DB=manufacturing_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# A2A Signing
A2A_SECRET_KEY=your-a2a-secret-key
A2A_SIGNATURE_ALGORITHM=HS256
A2A_KEY_ROTATION_DAYS=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
A2A_MAX_CONCURRENT=20
MAX_PARALLEL_AGENTS=3

# Token Budget (daily per workshop)
TOKEN_BUDGET_WARN_RATIO=0.8
TOKEN_BUDGET_DEGRADE_RATIO=0.9
TOKEN_BUDGET_LIMIT_RATIO=1.0

# Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MAX_COOLDOWN_SECONDS=300

# Checkpoint
CHECKPOINT_TTL_SECONDS=3600

# ML 推理服务（sidecar：视觉质检 :8001 / RUL 预测 :8002）
# 关闭 ML_ENABLED 后系统回退为纯 LLM 行为（融合前模式），可无损回滚
ML_ENABLED=true
ML_VISION_URL=http://localhost:8001
ML_RUL_URL=http://localhost:8002
ML_VISION_TIMEOUT=10.0
ML_RUL_TIMEOUT=5.0
# RUL 全局默认预警阈值（循环数）；单台设备可在设备台账 devices.rul_warn_cycles 覆盖
ML_RUL_WARN_CYCLES=50

# Offline Mode
OFFLINE_ENABLED=true
OFFLINE_LLM_MODEL=qwen-2.5-14b-int4

# Demo Password (开发/演示环境使用)
DEMO_PASSWORD=

# Logging
LOG_LEVEL=INFO

# HuggingFace 国内镜像（嵌入模型下载）
HF_ENDPOINT=https://hf-mirror.com

# Retrieval 混合检索权重（BM25:Dense，按查询类型自动切换）
RETRIEVAL_TOP_K=20
HYBRID_BM25_WEIGHT_EXACT=0.7
HYBRID_BM25_WEIGHT_MIXED=0.5
HYBRID_BM25_WEIGHT_SEMANTIC=0.3

# 上下文压缩（超过窗口 70% 触发启发式摘要；compressor_model 预留 LLM 摘要钩子）
CONTEXT_WINDOW_RATIO_THRESHOLD=0.7
COMPRESSOR_MODEL=qwen-turbo

# Ollama 独立端点（留空则沿用 OLLAMA_BASE_URL）
OFFLINE_LLM_BASE_URL=
